PORT=5000

# OpenAI API Key (for NLP: summaries, categorisation, gibberish filter)
OPENAI_API_KEY=your_openai_api_key_here

# Reddit API credentials (free - create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=PassportDashboard/1.0.0

# LibreTranslate (free, public instance - or self-host)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Set to "true" to use mock data instead of live APIs (for demo/testing)
USE_MOCK_DATA=true
